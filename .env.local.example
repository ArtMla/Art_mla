# Environment variables for the portfolio site
# Copy this file to .env.local and update values as needed

# Personal Contact
VITE_EMAIL=arthurmlambo@gmail.com
VITE_PHONE=+49-123-456789

# Social Media
VITE_GITHUB_USERNAME=artmla
VITE_LINKEDIN_PROFILE=art-mla
VITE_TWITTER_HANDLE=art_mla

# Asset Paths
VITE_ASSETS_DIR=/assets

# Site Configuration
VITE_SITE_TITLE=Arthur Mlambo - Data Science & Engineering
VITE_SITE_DESCRIPTION=Portfolio showcasing data science, machine learning, and engineering projects
VITE_SITE_URL=https://artmla-portfolio-beta.vercel.app

# Analytics (optional)
# VITE_ANALYTICS_ID=your-analytics-id

# Feature Flags
VITE_ENABLE_CONTACT_FORM=false
VITE_ENABLE_BLOG=false
